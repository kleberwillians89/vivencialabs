# Server only. Copy to .env.local. Never expose these in site-config.js / assets.
GOOGLE_APPS_SCRIPT_URL=
# Same value as LEADS_SECRET in Apps Script > Project Settings > Script Properties.
LEADS_SECRET=

# Private PDF storage only; no Supabase lead table.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MATERIALS_BUCKET=vivencia-materials
BRANDBOOK_OBJECT_PATH=brandbook/BRANDBOOK_VIVENCIA LAB_VERSAO.pdf
# Exact origin of the local Node server; adjust when publishing later.
SITE_ORIGIN=http://localhost:8081
